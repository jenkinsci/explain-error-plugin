<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:ee="/lib/explain-error">
    <j:set var="active" value="${it.pluginActive}" />
    <j:if test="${active}">
      <j:set var="enabled" value="${it.explainErrorEnabled}" />
      <j:set var="existingExplanation" value="${it.existingExplanation}" />
      <j:if test="${enabled or existingExplanation != null}">
        <script src="${rootURL}/plugin/explain-error/js/explain-error-footer.js" type="text/javascript"/>
        <ee:card surface="console" runUrl="${it.runUrl}" explainPath="console-explain-error/explainConsoleError"
                 providerName="${it.providerName}" enabled="${enabled}" explanation="${existingExplanation}"/>
      </j:if>
    </j:if>
</j:jelly>
