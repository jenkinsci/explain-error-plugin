<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="${%Failed builds}">
        <f:booleanRadio field="autoExplainOnFailure"
                        true="${%Explain automatically}"
                        false="${%Do not explain automatically}"/>
    </f:entry>
</j:jelly>
