<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:optionalBlock field="enableExplanation" title="Set AI error explanation for this folder"
                     checked="${instance.enableExplanation}" inline="true">
        <f:entry field="disableExplanation">
            <f:checkbox title="Turn off AI error explanation for jobs in this folder"/>
        </f:entry>
        <f:optionalBlock name="providerOverride" title="Use a different AI provider for this folder"
                         checked="${instance.aiProvider != null}"
                         help="${descriptor.getHelpFile('providerOverride')}">
            <f:dropdownDescriptorSelector title="AI Provider" field="aiProvider"/>
        </f:optionalBlock>
        <f:entry title="Custom Context" field="customContext"
                 description="Additional instructions or context for the AI. Overrides the global custom context for jobs in this folder.">
          <f:textarea />
        </f:entry>
        <f:entry title="Language" field="language"
                 description="Preferred response language for jobs in this folder. Leave empty to use global configuration.">
          <f:textbox />
        </f:entry>
        <f:entry title="Temperature" field="temperature"
                 description="Optional model temperature for jobs in this folder. Leave empty to use global configuration or provider defaults.">
          <f:number min="0" step="0.01" />
        </f:entry>
        <f:optionalBlock field="enableQuota" title="Enable Request Quota"
                         checked="${instance.enableQuota}" inline="true">
          <f:entry title="Quota Window" field="quotaWindow">
            <f:select />
          </f:entry>
          <f:entry title="Max Provider Calls per Window" field="maxProviderCallsPerWindow"
                   description="Maximum number of real AI provider calls allowed within the quota window. Overrides the global quota when configured. Cache hits do not count toward this limit.">
            <f:number clazz="setting-input" min="0" />
          </f:entry>
        </f:optionalBlock>
        <f:block>
            <p class="jenkins-!-margin-top-3">
                <strong>Note:</strong> Settings made here apply to this folder and its subfolders, and take
                precedence over the global configuration. What is not set here comes from the parent folder or
                the global configuration.
            </p>
        </f:block>
    </f:optionalBlock>
</j:jelly>
