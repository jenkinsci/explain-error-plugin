<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core"  xmlns:f="/lib/form">
  <f:entry title="API Key" field="apiKey">
    <f:password clazz="required"/>
  </f:entry>

  <f:entry title="Endpoint" field="url" description="Azure OpenAI endpoint (e.g., https://your-resource.openai.azure.com)">
    <f:textbox clazz="required"/>
  </f:entry>

  <f:entry title="Deployment Name" field="model" description="Azure deployment name (not the model name)">
    <f:textbox clazz="required" default="${descriptor.defaultModel}" autoCompleteUrl="${rootURL}/${descriptor.descriptorFullUrl}/autoCompleteModel"/>
  </f:entry>

  <f:validateButton title="Test Configuration" progress="Testing..."
                    method="testConfiguration" with="apiKey,url,model" />

</j:jelly>
