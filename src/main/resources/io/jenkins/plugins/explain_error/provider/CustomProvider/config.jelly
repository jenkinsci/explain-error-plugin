<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core"  xmlns:f="/lib/form">
  <f:entry title="URL" field="url">
    <f:textbox clazz="required"/>
  </f:entry>

  <f:entry title="Model" field="model">
    <f:textbox clazz="required" default="${descriptor.defaultModel}"/>
  </f:entry>

  <f:entry title="API Key" field="apiKey">
    <f:password clazz="required"/>
  </f:entry>

  <f:entry title="API Key Header" field="apiKeyHeader"
           description="Header that carries the key. Common values: Authorization or x-api-key.">
    <f:textbox default="${descriptor.defaultApiKeyHeader}"/>
  </f:entry>

  <f:entry title="API Key Prefix" field="apiKeyPrefix"
           description="Optional prefix prepended before the key (for example: Bearer). Leave empty for raw key values.">
    <f:textbox default="${descriptor.defaultApiKeyPrefix}"/>
  </f:entry>

  <f:entry title="Timeout (seconds)" field="timeoutSeconds"
           description="Request timeout for custom endpoint calls.">
    <f:number default="${descriptor.defaultTimeoutSeconds}" min="1" step="1"/>
  </f:entry>

  <f:validateButton title="Test Configuration" progress="Testing..."
                    method="testConfiguration" with="url,model,apiKey,apiKeyHeader,apiKeyPrefix,timeoutSeconds" />
</j:jelly>
