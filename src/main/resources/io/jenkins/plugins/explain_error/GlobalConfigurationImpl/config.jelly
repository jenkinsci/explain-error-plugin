<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="Explain Error Plugin Configuration">
      <f:optionalBlock field="enableExplanation" title="Enable AI Error Explanation" checked="${it.enableExplanation}" inline="true">
        <f:dropdownDescriptorSelector title="AI Provider" field="aiProvider"/>
        
        <f:entry title="Custom Context" field="customContext"
                 description="Additional instructions or context for the AI (e.g., KB article links, organization-specific troubleshooting steps). This can be overridden at the job level.">
          <f:textarea />
        </f:entry>
        <f:optionalBlock field="enableLogSanitization" title="Enable Log Sanitization"
                         checked="${it.enableLogSanitization}" inline="true">
          <f:entry title="Preview Payload Before Sending" field="enablePayloadPreview"
                   description="Require console action users to review the sanitized payload before it is sent to the AI provider.">
            <f:checkbox />
          </f:entry>
          <f:entry title="Audit Sent Payload" field="auditSentPayload"
                   description="Store the sanitized log payload that was sent with the build explanation action.">
            <f:checkbox />
          </f:entry>
          <f:entry title="Payload Allow Regex" field="payloadAllowRegex"
                   description="Optional regular expression. When set, only matching payload lines are sent.">
            <f:textbox />
          </f:entry>
          <f:entry title="Payload Deny Regex" field="payloadDenyRegex"
                   description="Optional regular expression. Matching text is replaced with [REDACTED_SECRET].">
            <f:textbox />
          </f:entry>
        </f:optionalBlock>
        <f:optionalBlock field="enableQuota" title="Enable Request Quota"
                         checked="${it.enableQuota}" inline="true">
          <f:entry title="Quota Window" field="quotaWindow">
            <f:select />
          </f:entry>
          <f:entry title="Max Provider Calls per Window" field="maxProviderCallsPerWindow"
                   description="Maximum number of real AI provider calls allowed within the quota window. Cache hits do not count toward this limit.">
            <f:number clazz="setting-input" min="0" />
          </f:entry>
        </f:optionalBlock>
      </f:optionalBlock>
    </f:section>
</j:jelly>
