<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="Explain Error Plugin Configuration">
      <f:optionalBlock field="enableExplanation" title="Enable AI Error Explanation" checked="${it.enableExplanation}" inline="true">
        <f:dropdownDescriptorSelector title="AI Provider" field="aiProvider"/>
        
        <f:entry title="Custom Context" field="customContext"
                 description="Additional instructions or context for the AI (e.g., KB article links, organization-specific troubleshooting steps). This can be overridden at the job level.">
          <f:textarea />
        </f:entry>
      </f:optionalBlock>
    </f:section>
    <f:section title="Explain Error Plugin - Usage Statistics">
        <j:set var="topJobs" value="${it.topJobs}"/>
        <table class="jenkins-table">
            <tbody>
                <tr>
                    <th scope="row">Total AI Calls</th>
                    <td>${it.totalCalls}</td>
                </tr>
                <tr>
                    <th scope="row">Calls This Month</th>
                    <td>${it.callsThisMonth}</td>
                </tr>
            </tbody>
        </table>
        <h4>Top Jobs by Usage</h4>
        <table class="jenkins-table sortable">
            <thead>
                <tr>
                    <th>Job</th>
                    <th>Total Calls</th>
                </tr>
            </thead>
            <tbody>
                <j:if test="${topJobs.isEmpty()}">
                    <tr>
                        <td colspan="2">No AI calls recorded yet.</td>
                    </tr>
                </j:if>
                <j:forEach items="${topJobs}" var="entry">
                    <tr>
                        <td>${entry.key}</td>
                        <td>${entry.value}</td>
                    </tr>
                </j:forEach>
            </tbody>
        </table>
    </f:section>
</j:jelly>
