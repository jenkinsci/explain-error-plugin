<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="Explain Error Plugin Configuration">
        <f:entry title="Enable AI Error Explanation" field="enableExplanation">
            <f:checkbox />
        </f:entry>
        
        <f:entry title="AI Provider" field="provider">
            <f:select />
        </f:entry>
        
        <f:entry title="API Key" field="apiKey">
            <j:choose>
                <j:when test="${instance.provider == 'OLLAMA'}">
                    <f:password disabled="true" default=""/>
                    <div style="color: #888; font-size: 90%;">Ollama does not require an API key.</div>
                </j:when>
                <j:otherwise>
                    <f:password clazz="required"/>
                </j:otherwise>
            </j:choose>
        </f:entry>
        
        <f:entry title="API URL" field="apiUrl">
            <f:textbox clazz="required"/>
        </f:entry>
        
        <f:entry title="AI Model" field="model">
            <f:textbox clazz="required"/>
        </f:entry>
        
        <f:entry title="">
            <div>
                <f:validateButton title="Test Configuration" progress="Testing..." 
                                method="testConfiguration" with="apiKey,provider,apiUrl,model" />
            </div>
        </f:entry>
    </f:section>
</j:jelly>
