<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:ee="/lib/explain-error">
    <j:set var="active" value="${it.pluginActive}" />
    <j:if test="${active}">
      <j:set var="enabled" value="${it.explainErrorEnabled}" />
      <j:if test="${enabled or it.existingExplanation != null}">
        <script src="${rootURL}/plugin/explain-error/js/explain-error-footer.js" type="text/javascript"/>
        <script src="${rootURL}/plugin/explain-error/js/explain-error-graph-view.js" type="text/javascript"/>
        <!-- Which explanation applies depends on the stage selected, so none is rendered with the page -->
        <ee:card surface="graph-view" runUrl="${it.runUrl}" explainPath="graph-explain-error/explainNodeError"
                 providerName="${it.providerName}" enabled="${enabled}" logLink="false"/>
      </j:if>
    </j:if>
</j:jelly>
