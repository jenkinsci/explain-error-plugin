<?jelly escape-by-default='true'?>
<!--
  The explanation itself, shared by the build's "AI Error Explanation" page and the card on the
  console page. Everything the model wrote is escaped: the *Html getters escape before adding
  <code> elements, and the rest goes through Jelly's own escaping.
-->
<j:jelly xmlns:j="jelly:core">
    <j:choose>
        <j:when test="${it.structured}">
            <j:set var="labels" value="${it.labels}"/>
            <div class="eep-explanation">
                <p class="eep-summary"><j:out value="${it.summaryHtml}"/></p>
                <j:set var="steps" value="${it.resolutionStepsHtml}"/>
                <j:if test="${!steps.isEmpty()}">
                    <h3 class="eep-heading">${labels.howToFix}</h3>
                    <ol class="eep-steps">
                        <j:forEach var="step" items="${steps}">
                            <li><j:out value="${step}"/></li>
                        </j:forEach>
                    </ol>
                </j:if>
                <j:if test="${it.errorSignature != null and !it.errorSignature.isBlank()}">
                    <details class="eep-details" open="open">
                        <summary>${labels.whereItFailed}</summary>
                        <pre class="eep-snippet">${it.errorSignature}</pre>
                    </details>
                </j:if>
                <j:set var="practices" value="${it.bestPracticesHtml}"/>
                <j:if test="${!practices.isEmpty()}">
                    <details class="eep-details">
                        <summary>${labels.bestPracticesHeading}</summary>
                        <ul class="eep-practices">
                            <j:forEach var="practice" items="${practices}">
                                <li><j:out value="${practice}"/></li>
                            </j:forEach>
                        </ul>
                    </details>
                </j:if>
                <j:if test="${!it.providerLabel.isEmpty() or it.inputLogLineCount > 0}">
                    <p class="eep-meta">
                        ${it.providerLabel}
                        <j:if test="${it.inputLogLineCount > 0}">
                            <j:if test="${!it.providerLabel.isEmpty()}"> &#183; </j:if>
                            ${labels.linesAnalysed(it.inputLogLineCount)}
                        </j:if>
                    </p>
                </j:if>
            </div>
        </j:when>
        <j:otherwise>
            <pre class="eep-plain">${it.explanation}</pre>
        </j:otherwise>
    </j:choose>
</j:jelly>
